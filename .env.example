# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# MongoDB connection string (Atlas, or local: mongodb://localhost:27017/krishokbondhon)
MONGO_URI=mongodb://localhost:27017/krishokbondhon

# Must match the secret your Postgres-backed auth service signs JWTs with.
JWT_SECRET=replace-with-a-long-random-string

# Base URL of the FastAPI NLP microservice that generates AI answers.
# Not called yet in this scaffold — see src/services/nlpService.js.
NLP_SERVICE_URL=http://localhost:8001

# Base URL of the (not yet built) Postgres-backed expert directory
# service, used to match new questions to experts by specialty/language.
# Not called yet — see src/services/expertNotificationService.js.
EXPERT_SERVICE_URL=http://localhost:5000

# --- Image storage ---
# "local" (default): saves images to ./uploads on disk. Zero setup, zero
#   cost — use this for free local development.
# "gcs": saves images to Google Cloud Storage. Use this only once you're
#   deploying for real (see README's "Deploying to Google Cloud Run").
STORAGE_DRIVER=local

# Only read when STORAGE_DRIVER=gcs — ignore these during local development.
GCS_BUCKET_NAME=krishokbondhon-post-images
# Only needed for testing STORAGE_DRIVER=gcs from your own machine (rather
# than from within Cloud Run, which authenticates automatically):
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
